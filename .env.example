PORT=8787
VITE_API_URL=http://localhost:8787
CORS_ORIGIN=http://localhost:5173
# Leave blank for the disposable local store; required in production.
MONGODB_URI=
MONGODB_DATABASE=mealwise
# auto: use the selected provider when a key is present, otherwise the local parser.
# model: require AI; local: offline parser only. All offers are mock data.
AGENT_MODE=auto
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional alternative: set AI_PROVIDER=openai to use these settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
